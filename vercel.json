{
  "version": 2,
  "builds": [
    { "src": "ui/package.json", "use": "@vercel/static-build", "config": { "distDir": "build" } },
    { "src": "api/**/*.py", "use": "@vercel/python" }
  ],
  "functions": {
    "api/**/*.py": {
      "includeFiles": "app/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
